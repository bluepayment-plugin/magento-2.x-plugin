<?php
/**
 * @var \BlueMedia\BluePayment\Block\ConsumerFinance $block
 */

$items = [];

if ($block->isInstallmentsAvailable()) {
    $items[] = [
        'type' => 'installments',
        'label' => (string) __('INSTALLMENTS'),
        'text' => (string) __('Up to 48 installments'),
    ];
}

if ($block->isHubAvailable()) {
    $items[] = [
        'type' => 'hub',
        'label' => (string) __('TAILORED INSTALLMENTS'),
        'text' => (string) __('Buy on tailored installments'),
    ];
}
?>
<?php if ($block->isEnabled() && $items): ?>
    <div class="bluemedia consumer-finance horizontal position-<?= $block->escapeHtmlAttr($block->getPosition()) ?>">
        <?php foreach ($items as $item): ?>
            <div class="cf-item <?= $block->escapeHtmlAttr($item['type']) ?>">
                <span class="label"><?= $block->escapeHtml($item['label']) ?></span>
                <span class="text"><?= $block->escapeHtml($item['text']) ?></span>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
